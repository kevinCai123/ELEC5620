      },
      "StudyPlanCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/StudyPlanItemRequest"
            },
            "type": "array",
            "title": "Items"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string",
