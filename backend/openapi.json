            "title": "Created By"
          }
        },
        "type": "object",
        "required": [
          "title",
          "items"
        ],
        "title": "StudyPlanCreateRequest"
      },
      "StudyPlanCreateResponse": {
        "properties": {
          "plan_id": {
            "type": "integer",
            "title": "Plan Id"
          }
        },
        "type": "object",
        "required": [
          "plan_id"
        ],
        "title": "StudyPlanCreateResponse"
      },
      "StudyPlanItemRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          },
          "due_at": {
            "type": "string",
            "format": "date-time",
            "title": "Due At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "due_at"
        ],
        "title": "StudyPlanItemRequest"
      },
      "SummarizeRequest": {
        "properties": {
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "Raw text to summarise"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "URL to summarise"
          },
          "user_request": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "User Request",
            "description": "Specific task for the summariser (e.g., extract links, summarise, answer questions)",
            "default": "auto"
          }
        },
        "type": "object",
        "title": "SummarizeRequest"
