  "components": {
    "schemas": {
      "CampusPlace": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "CampusPlace"
      },
      "DigestPreferenceRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "User Id"
          },
          "digest_enabled": {
            "type": "boolean",
            "title": "Digest Enabled"
          },
          "digest_time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "Digest Time"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Australia/Sydney"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "digest_enabled",
          "digest_time"
        ],
        "title": "DigestPreferenceRequest"
      },
      "DigestPreferenceResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "digest_enabled": {
            "type": "boolean",
            "title": "Digest Enabled"
          },
          "digest_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Digest Time"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "digest_enabled",
          "digest_time",
          "timezone"
        ],
        "title": "DigestPreferenceResponse"
      },
      "DigestPreviewResponse": {
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/DigestPreviewSection"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "generated_at",
          "sections"
        ],
        "title": "DigestPreviewResponse"
      },
      "DigestPreviewSection": {
        "properties": {
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "heading",
          "items"
        ],
        "title": "DigestPreviewSection"
      },
      "EmailSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "sender": {
            "type": "string",
            "title": "Sender"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "1-2 sentence summary of the email"
          },
          "key_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Key Points",
            "description": "Key action items or important points"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Email category (e.g., academic, admin, social, promotional)",
            "default": "general"
          },
          "original_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "subject",
          "sender",
          "summary"
        ],
        "title": "EmailSummary"
      },
